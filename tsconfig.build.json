{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false,
    "rootDir": "src",
    "outDir": "dist/types",
    "types": []
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.stories.tsx",
    "src/**/*.mdx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/stories"
  ]
}
