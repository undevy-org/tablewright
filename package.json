{
  "name": "@undevy-org/tablewright",
  "version": "0.7.2",
  "description": "React data-table and application-shell components: filters, drawers, row controls, sortable and resizable columns, built on Radix UI and TanStack Table.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/undevy-org/tablewright.git"
  },
  "homepage": "https://github.com/undevy-org/tablewright#readme",
  "bugs": {
    "url": "https://github.com/undevy-org/tablewright/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/tablewright.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/tablewright.cjs",
      "default": "./dist/es/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tablewright.css": "./dist/tablewright.css",
    "./preflight.css": "./dist/preflight.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:js": "vite build --config vite.lib.config.ts",
    "build:css": "node scripts/build-css.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "check:render": "node scripts/render-check/run.mjs",
    "lint": "eslint src .storybook --max-warnings=0",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "*",
    "@types/react-dom": "*",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.577.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-themes": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.5.8",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.5.8",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
